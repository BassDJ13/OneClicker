<Window x:Class="OneClicker.Forms.WidgetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneClicker" Height="350" Width="525" WindowStyle="None" Topmost="True" ShowInTaskbar="True">
    <Grid>
        <DockPanel LastChildFill="True">
            <Border Background="SlateBlue" Height="32" DockPanel.Dock="Top">
                <TextBlock Text="OneClicker (WPF Dummy Content)" Foreground="White" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="LightGray" Padding="24" Margin="12" CornerRadius="8">
                    <TextBlock Text="Widget 1" FontSize="18"/>
                </Border>
                <Border Background="LightGray" Padding="24" Margin="12" CornerRadius="8">
                    <TextBlock Text="Widget 2" FontSize="18"/>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
