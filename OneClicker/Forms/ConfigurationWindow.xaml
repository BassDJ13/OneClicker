<Window x:Class="OneClicker.Forms.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneClicker Configuration" Height="400" Width="600" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="NavList" Grid.Column="0" />
        <Border Grid.Column="1" Margin="10">
            <ContentControl x:Name="ContentPanel" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Grid.ColumnSpan="2">
            <Button x:Name="SaveButton" Content="Save" Width="80" Margin="0,0,10,0" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" />
        </StackPanel>
        <TextBlock x:Name="UpdateLink" Text="Update available" Foreground="Blue" Visibility="Collapsed" Margin="10,10,0,0" VerticalAlignment="Top" Cursor="Hand" />
    </Grid>
</Window>
